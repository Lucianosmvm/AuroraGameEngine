<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aurora.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Aurora.Editor/Views/Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#7C5CFF</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Editor de código C# embutido (ScriptEditorWindow) — sem este tema o TextEditor
         renderiza sem cores nem gutter de linhas. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://Aurora.Editor/Views/EditorStyles.axaml"/>
  </Application.Styles>
</Application>
