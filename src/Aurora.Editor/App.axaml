<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aurora.Editor.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="SystemAccentColor">#4A90D9</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Editor de código C# embutido (ScriptEditorWindow) — sem este tema o TextEditor
         renderiza sem cores nem gutter de linhas. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
  </Application.Styles>
</Application>
