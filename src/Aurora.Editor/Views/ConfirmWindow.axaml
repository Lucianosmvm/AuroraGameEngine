<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aurora.Editor.Views.ConfirmWindow"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F2F4F7"
        Title="Confirmar">

  <StackPanel Margin="16" Spacing="12">

    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"/>

    <TextBlock x:Name="DetailText" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancelar" FontSize="12" Padding="16,5"
              Click="OnCancel" IsCancel="True"/>
      <Button x:Name="ConfirmButton" Content="Excluir" FontSize="12" Padding="16,5"
              Background="#C0392B" Foreground="#FFFFFF" Click="OnConfirm" IsDefault="True"/>
    </StackPanel>

  </StackPanel>
</Window>
