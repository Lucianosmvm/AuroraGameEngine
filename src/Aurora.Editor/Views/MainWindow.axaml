<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Aurora.Editor.Views"
        xmlns:vm="clr-namespace:Aurora.Editor.ViewModels"
        x:Class="Aurora.Editor.Views.MainWindow"
        Title="{Binding Title}"
        Width="1400" Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">

  <Window.DataTemplates>
    <!-- Editores de propriedades escalares -->
    <DataTemplate DataType="{x:Type vm:NumberPropertyViewModel}">
      <Grid ColumnDefinitions="90,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
        <TextBox Grid.Column="1" Text="{Binding Text}" FontSize="12" Padding="6,4"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TextPropertyViewModel}">
      <Grid ColumnDefinitions="90,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12" Padding="6,4"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BoolPropertyViewModel}">
      <CheckBox Content="{Binding Name}" IsChecked="{Binding Value}" Margin="0,2" FontSize="12"/>
    </DataTemplate>
    <!-- Campo com sugestão: aceita qualquer texto, lista o que existe no projeto -->
    <DataTemplate DataType="{x:Type vm:SuggestPropertyViewModel}">
      <Grid ColumnDefinitions="90,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Top" Opacity="0.7" FontSize="12"
                   Margin="0,5,0,0"/>
        <StackPanel Grid.Column="1" Spacing="1">
          <AutoCompleteBox ItemsSource="{Binding Suggestions}" Text="{Binding Value}"
                           FontSize="12" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                           HorizontalAlignment="Stretch"/>
          <TextBlock Text="{Binding Hint}" FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                     IsVisible="{Binding HasHint}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EnumPropertyViewModel}">
      <Grid ColumnDefinitions="90,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected}" FontSize="12"
                  HorizontalAlignment="Stretch"/>
      </Grid>
    </DataTemplate>

    <!-- Textura: miniatura clicável abre a lista de assets do projeto + "procurar no computador" -->
    <DataTemplate DataType="{x:Type vm:TexturePropertyViewModel}">
      <Grid ColumnDefinitions="90,Auto,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>

        <Button Grid.Column="1" Padding="3" Margin="0,0,4,0" AutomationProperties.Name="Escolher textura"
                ToolTip.Tip="Escolher imagem">
          <Panel Width="26" Height="20">
            <Image Source="{Binding Preview}" Stretch="Uniform"
                   IsVisible="{Binding HasPreview}"/>
            <TextBlock Text="🖼" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.55" IsVisible="{Binding !HasPreview}"/>
          </Panel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="300" Spacing="8">
                <TextBlock Text="Imagens do projeto" FontWeight="SemiBold" FontSize="12"/>

                <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Assets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="6,3" Margin="0,1" Background="Transparent"
                                AutomationProperties.Name="{Binding RelativePath}"
                                Command="{Binding $parent[ItemsControl].DataContext.PickCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="{Binding Thumbnail}" Width="28" Height="28" Stretch="Uniform"/>
                            <TextBlock Text="{Binding RelativePath}" VerticalAlignment="Center" FontSize="12"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Grid ColumnDefinitions="*,Auto">
                  <Button Content="Procurar no computador…" HorizontalAlignment="Stretch" FontSize="12"
                          AutomationProperties.Name="Procurar no computador"
                          Command="{Binding BrowseCommand}"/>
                  <Button Grid.Column="1" Content="Limpar" Margin="6,0,0,0" FontSize="12"
                          Command="{Binding ClearCommand}"/>
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBox Grid.Column="2" Text="{Binding Value}" FontSize="12" Padding="6,4"
                 Watermark="sprites/exemplo.png"/>

        <TextBlock Grid.Column="2" Text="⚠" FontSize="14" Foreground="#D68A00"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                   IsVisible="{Binding IsMissing}"
                   ToolTip.Tip="Este arquivo não está na pasta de assets do projeto"/>
      </Grid>
    </DataTemplate>

    <!-- Cor: a amostra abre a paleta nomeada + opacidade; o hex continua editável ao lado -->
    <DataTemplate DataType="{x:Type vm:ColorPropertyViewModel}">
      <Grid ColumnDefinitions="90,Auto,*" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>

        <Button Grid.Column="1" Padding="3" Margin="0,0,4,0" ToolTip.Tip="{Binding ColorName}"
                AutomationProperties.Name="Escolher cor">
          <Border Background="{Binding Preview}" Width="26" Height="16"
                  BorderBrush="#99A0AA" BorderThickness="1" CornerRadius="2"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="290" Spacing="8">
                <TextBlock Text="{Binding ColorName}" FontWeight="SemiBold" FontSize="12"/>

                <ItemsControl ItemsSource="{Binding Choices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="33" Height="26" Margin="1" Padding="0"
                              Background="{Binding Brush}" BorderBrush="#99A0AA" BorderThickness="1"
                              ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                              Command="{Binding Command}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,*,44">
                  <TextBlock Text="Opacidade" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                  <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100"
                          Value="{Binding Opacity}"/>
                  <TextBlock Grid.Column="2" Text="{Binding OpacityText}" VerticalAlignment="Center"
                             FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBox Grid.Column="2" Text="{Binding Value}" FontSize="12" Padding="6,4"/>
      </Grid>
    </DataTemplate>

    <!-- Animator: campos básicos + lista de clipes -->
    <DataTemplate DataType="{x:Type vm:AnimatorViewModel}">
      <Panel Margin="0,0,0,6">
        <Expander Header="Animator" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Margin="6,4" Spacing="4">
            <ItemsControl ItemsSource="{Binding Properties}" Margin="0,0,0,4"/>
            <Border BorderThickness="0,1,0,0" BorderBrush="#D7DEE8"
                    Margin="0,2,0,2" Padding="0,4,0,0">
              <TextBlock Text="CLIPES" FontSize="10" FontWeight="Bold" Opacity="0.5"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Clips}"/>
            <Button Content="+ Clipe" Command="{Binding AddClipCommand}"
                    FontSize="12" HorizontalAlignment="Stretch" Margin="0,2"/>

            <Border BorderThickness="0,1,0,0" BorderBrush="#D7DEE8"
                    Margin="0,4,0,2" Padding="0,4,0,0">
              <TextBlock Text="TRANSIÇÕES" FontSize="10" FontWeight="Bold" Opacity="0.5"/>
            </Border>
            <TextBlock Text="Troca de clipe sozinho quando o parâmetro atinge a condição. Sete o parâmetro num script: anim.SetFloat(&quot;Speed&quot;, valor) ou anim.SetBool(&quot;Nome&quot;, valor)."
                       FontSize="10" FontStyle="Italic" Opacity="0.45" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <ItemsControl ItemsSource="{Binding Transitions}"/>
            <Button Content="+ Transição" Command="{Binding AddTransitionCommand}"
                    FontSize="12" HorizontalAlignment="Stretch" Margin="0,2"/>
          </StackPanel>
        </Expander>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Content="✕" FontSize="10" Padding="5,1" Margin="0,3,4,0"
                Command="{Binding RemoveCommand}"
                IsVisible="{Binding RemoveCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="Transparent" Foreground="#D64545" BorderThickness="0"/>
      </Panel>
    </DataTemplate>

    <!-- AnimationClip: uma linha por clipe -->
    <DataTemplate DataType="{x:Type vm:AnimationClipViewModel}">
      <Border Background="#EDF2FA" CornerRadius="4" Margin="0,2" Padding="6,5">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding ClipName}" FontSize="12" Padding="4,3" Watermark="Nome…"/>
            <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                    Command="{Binding RemoveCommand}" Foreground="#D64545"
                    Background="Transparent" BorderThickness="0"/>
          </Grid>
          <Grid ColumnDefinitions="60,*,8,35,*">
            <TextBlock Text="Frames" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding FramesText}" FontSize="11" Padding="4,3"
                     Watermark="0, 1, 2…"/>
            <TextBlock Grid.Column="3" Text="Dur" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="4" Text="{Binding FrameDurationText}" FontSize="11" Padding="4,3"/>
          </Grid>
          <CheckBox Content="Loop" IsChecked="{Binding Loop}" FontSize="11"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- AnimatorTransition: De -> Para, condição sobre um parâmetro local -->
    <DataTemplate DataType="{x:Type vm:AnimatorTransitionViewModel}">
      <Border Background="#EDF2FA" CornerRadius="4" Margin="0,2" Padding="6,5">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,20,*,Auto">
            <TextBox Text="{Binding From}" FontSize="11" Padding="4,3" Watermark="Any"/>
            <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6"/>
            <TextBox Grid.Column="2" Text="{Binding To}" FontSize="11" Padding="4,3" Watermark="clipe…"/>
            <Button Grid.Column="3" Content="✕" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                    Command="{Binding RemoveCommand}" Foreground="#D64545"
                    Background="Transparent" BorderThickness="0"/>
          </Grid>
          <Grid ColumnDefinitions="60,*">
            <TextBlock Text="Parâmetro" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding Parameter}" FontSize="11" Padding="4,3" Watermark="Speed…"/>
          </Grid>
          <CheckBox Content="É bool (em vez de número)" IsChecked="{Binding IsBool}" FontSize="11"/>
          <Grid ColumnDefinitions="60,70,*" IsVisible="{Binding ShowCompare}">
            <TextBlock Text="Condição" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding CompareOps}"
                      SelectedItem="{Binding CompareOp}" FontSize="11" Margin="0,0,4,0"/>
            <TextBox Grid.Column="2" Text="{Binding CompareValueText}" FontSize="11" Padding="4,3"/>
          </Grid>
          <CheckBox Content="Precisa estar ligado" IsChecked="{Binding BoolValue}" FontSize="11"
                    IsVisible="{Binding ShowBoolValue}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- EventTrigger: editor completo de gatilho + lista de ações -->
    <!-- IMPORTANTE: precisa vir antes do template genérico de ComponentViewModel logo abaixo —
         no Avalonia o primeiro DataTemplate que bate vence, e EventTriggerViewModel herda de
         ComponentViewModel, então na ordem errada o genérico casa primeiro e essa view nunca aparece. -->
    <DataTemplate DataType="{x:Type vm:EventTriggerViewModel}">
      <Panel Margin="0,0,0,6">
      <Expander Header="EventTrigger" IsExpanded="True"
                HorizontalAlignment="Stretch">
        <StackPanel Margin="6,4" Spacing="4">

          <!-- Tipo de gatilho -->
          <Grid ColumnDefinitions="90,*">
            <TextBlock Text="Trigger" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerTypes}"
                      SelectedItem="{Binding TriggerType}" FontSize="12"/>
          </Grid>
          <TextBlock Text="{Binding TriggerDescription}" FontSize="11" FontStyle="Italic"
                     Opacity="0.5" Margin="0,-2,0,2"/>

          <!-- Once -->
          <CheckBox Content="Once (dispara uma vez)" IsChecked="{Binding Once}" FontSize="12"/>

          <!-- Radius — só PlayerTouch -->
          <Grid ColumnDefinitions="90,*" IsVisible="{Binding ShowRadius}">
            <TextBlock Text="Radius" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <TextBox Grid.Column="1" Text="{Binding RadiusText}" FontSize="12" Padding="6,4"/>
          </Grid>

          <!-- Switch — só SwitchOn -->
          <Grid ColumnDefinitions="90,*" IsVisible="{Binding ShowSwitch}">
            <TextBlock Text="Switch" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <TextBox Grid.Column="1" Text="{Binding SwitchName}" FontSize="12" Padding="6,4"/>
          </Grid>

          <!-- TargetPrefix — só Touch -->
          <Grid ColumnDefinitions="90,*" IsVisible="{Binding ShowTargetPrefix}">
            <TextBlock Text="Só o nome" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <TextBox Grid.Column="1" Text="{Binding TargetPrefix}" FontSize="12" Padding="6,4"
                     Watermark="Player… (vazio = qualquer um)"/>
          </Grid>

          <!-- Key — só KeyPress -->
          <Grid ColumnDefinitions="90,*" IsVisible="{Binding ShowKey}">
            <TextBlock Text="Tecla" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding KeyNames}" Text="{Binding Key}"
                             FontSize="12" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Watermark="Space, E, Enter…" HorizontalAlignment="Stretch"/>
          </Grid>

          <!-- Interval — só Timer -->
          <Grid ColumnDefinitions="90,*" IsVisible="{Binding ShowInterval}">
            <TextBlock Text="Intervalo (s)" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
            <TextBox Grid.Column="1" Text="{Binding IntervalText}" FontSize="12" Padding="6,4"/>
          </Grid>

          <!-- VariableCompare/HasItem/QuestStageAtLeast: nome op valor -->
          <StackPanel IsVisible="{Binding ShowCompare}" Spacing="4">
            <Grid ColumnDefinitions="90,*">
              <TextBlock Text="{Binding CompareLabel}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
              <TextBox Grid.Column="1" Text="{Binding Variable}" FontSize="12" Padding="6,4"
                       Watermark="Gold, Life…"/>
            </Grid>
            <Grid ColumnDefinitions="90,100,*">
              <TextBlock Text="Condição" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding CompareOps}"
                        SelectedItem="{Binding CompareOp}" FontSize="12" Margin="0,0,4,0"/>
              <TextBox Grid.Column="2" Text="{Binding CompareValueText}" FontSize="12" Padding="6,4"/>
            </Grid>
          </StackPanel>

          <!-- Separador de ações -->
          <Border BorderThickness="0,1,0,0" BorderBrush="#D7DEE8"
                  Margin="0,4,0,2" Padding="0,4,0,0">
            <TextBlock Text="AÇÕES" FontSize="10" FontWeight="Bold" Opacity="0.5"/>
          </Border>

          <ItemsControl ItemsSource="{Binding Actions}"/>

          <Button Content="+ Adicionar Ação" Command="{Binding AddActionCommand}"
                  FontSize="12" HorizontalAlignment="Stretch" Margin="0,2"/>
        </StackPanel>
      </Expander>
      <Button HorizontalAlignment="Right" VerticalAlignment="Top"
              Content="✕" FontSize="10" Padding="5,1" Margin="0,3,4,0"
              Command="{Binding RemoveCommand}"
              IsVisible="{Binding RemoveCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="Transparent" Foreground="#D64545" BorderThickness="0"/>
      </Panel>
    </DataTemplate>

    <!-- UiButton: campos escalares genéricos + lista de ações OnClick -->
    <!-- IMPORTANTE: precisa vir antes do template genérico de ComponentViewModel logo abaixo,
         mesma razão do EventTriggerViewModel acima (UiButtonViewModel também herda dele). -->
    <DataTemplate DataType="{x:Type vm:UiButtonViewModel}">
      <Panel Margin="0,0,0,6">
        <Expander Header="UiButton" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Margin="6,4" Spacing="4">
            <ItemsControl ItemsSource="{Binding Properties}"/>

            <Border BorderThickness="0,1,0,0" BorderBrush="#D7DEE8"
                    Margin="0,2,0,2" Padding="0,4,0,0">
              <TextBlock Text="ONCLICK" FontSize="10" FontWeight="Bold" Opacity="0.5"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Actions}"/>

            <Button Content="+ Adicionar Ação" Command="{Binding AddActionCommand}"
                    FontSize="12" HorizontalAlignment="Stretch" Margin="0,2"/>
          </StackPanel>
        </Expander>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Content="✕" FontSize="10" Padding="5,1" Margin="0,3,4,0"
                Command="{Binding RemoveCommand}"
                IsVisible="{Binding RemoveCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="Transparent" Foreground="#D64545" BorderThickness="0"/>
      </Panel>
    </DataTemplate>

    <!-- Componente genérico (Transform, SpriteRenderer, Tilemap, Collider…) -->
    <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
      <Panel Margin="0,0,0,6">
        <Expander Header="{Binding Type}" IsExpanded="True" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding Properties}" Margin="4"/>
        </Expander>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Content="✕" FontSize="10" Padding="5,1" Margin="0,3,4,0"
                Command="{Binding RemoveCommand}"
                IsVisible="{Binding RemoveCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="Transparent" Foreground="#D64545" BorderThickness="0"/>
      </Panel>
    </DataTemplate>

    <!-- Uma ação dentro de EventTrigger -->
    <DataTemplate DataType="{x:Type vm:EventActionViewModel}">
      <Border Background="#EDF2FA" CornerRadius="4" Margin="0,2" Padding="6,5">
        <StackPanel Spacing="3">

          <!-- Tipo + botão remover -->
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding ActionTypes}"
                      SelectedItem="{Binding ActionType}" FontSize="12"/>
            <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                    Command="{Binding RemoveCommand}" Foreground="#D64545"
                    Background="Transparent" BorderThickness="0"/>
          </Grid>
          <TextBlock Text="{Binding ActionDescription}" FontSize="10" FontStyle="Italic"
                     Opacity="0.5" Margin="0,-1,0,2"/>

          <!-- Nome (variável, entidade, item, arquivo de som…). AutoCompleteBox e não TextBox:
               aceita qualquer texto (a entidade alvo pode nascer só em jogo) mas lista o que já
               existe no projeto, que é onde mora o erro de digitação difícil de achar. -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowNameText}">
            <TextBlock Text="{Binding NameLabel}" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="11"/>
            <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding NameSuggestions}"
                             Text="{Binding Name}" FontSize="11"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             HorizontalAlignment="Stretch"/>
          </Grid>

          <!-- Nome via seletor (ChangeScene: cenas do projeto; ShowUI/HideUI/ToggleUI: telas de UI) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowNamePicker}">
            <TextBlock Text="{Binding NameLabel}" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="11"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding NamePickerOptions}"
                      SelectedItem="{Binding Name}" FontSize="11"/>
          </Grid>

          <!-- Op: Set / Add (SetVariable) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowOp}">
            <TextBlock Text="Op" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding OpTypes}"
                      SelectedItem="{Binding Op}" FontSize="11"/>
          </Grid>

          <!-- Valor numérico -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowValue}">
            <TextBlock Text="{Binding ValueLabel}" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding ValueText}" FontSize="11" Padding="4,3"/>
          </Grid>

          <!-- On / Loop (SetSwitch, PlayMusic) -->
          <CheckBox Content="{Binding OnLabel}" IsChecked="{Binding On}"
                    FontSize="11" IsVisible="{Binding ShowOn}" Margin="0,1"/>

          <!-- X / Y (Teleport) -->
          <Grid ColumnDefinitions="28,*,8,28,*" IsVisible="{Binding ShowXY}">
            <TextBlock Text="X" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding XText}" FontSize="11" Padding="4,3"/>
            <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="4" Text="{Binding YText}" FontSize="11" Padding="4,3"/>
          </Grid>

          <!-- Tipo da condição (If) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowConditionKind}">
            <TextBlock Text="Comparar" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ConditionKinds}"
                      SelectedItem="{Binding ConditionKind}" FontSize="11" HorizontalAlignment="Stretch"/>
          </Grid>

          <!-- Ponto de spawn (ChangeScene) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowSpawnPoint}">
            <TextBlock Text="Chegar em" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding SpawnPoint}" FontSize="11" Padding="4,3"
                     Watermark="nome do marcador na cena de destino"/>
          </Grid>

          <!-- Chance (qualquer ação que não seja de fluxo) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowChance}">
            <TextBlock Text="Chance" VerticalAlignment="Center" Opacity="0.6" FontSize="11"
                       ToolTip.Tip="0 a 1. 1 = sempre acontece."/>
            <TextBox Grid.Column="1" Text="{Binding ChanceText}" FontSize="11" Padding="4,3"/>
          </Grid>

          <!-- Segundos (Wait) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowSeconds}">
            <TextBlock Text="Segundos" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding SecondsText}" FontSize="11" Padding="4,3"/>
          </Grid>

          <!-- Texto / Clipe (ShowMessage, ShowChoice, PlayAnimation) -->
          <Grid ColumnDefinitions="65,*" IsVisible="{Binding ShowText}">
            <TextBlock Text="{Binding TextLabel}" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
            <TextBox Grid.Column="1" Text="{Binding Text}" FontSize="11" Padding="4,3"
                     TextWrapping="Wrap"/>
          </Grid>

          <!-- Opções de ShowChoice -->
          <StackPanel IsVisible="{Binding ShowOptions}" Margin="0,4,0,0">
            <TextBlock Text="Opções:" FontSize="10" Opacity="0.6" Margin="0,0,0,2"/>
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,76,Auto" Margin="0,1" ColumnSpacing="4">
                    <TextBox Text="{Binding Text}" FontSize="11" Padding="4,2"
                             Watermark="Texto da opção…"/>
                    <TextBox Grid.Column="1" Text="{Binding SwitchName}" FontSize="11"
                             Padding="4,2" Watermark="Switch"/>
                    <Button Grid.Column="2" Content="✕" FontSize="10" Padding="4,2"
                            Command="{Binding RemoveCommand}" Foreground="#D64545"
                            Background="Transparent" BorderThickness="0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Opção" Command="{Binding AddOptionCommand}"
                    FontSize="11" Margin="0,2"/>
          </StackPanel>

        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Arquivo">
        <MenuItem Header="Novo _Projeto…" Click="OnNewProject" InputGesture="Ctrl+Shift+N"/>
        <MenuItem Header="Abrir _Projeto…" Click="OnOpenProject" InputGesture="Ctrl+Shift+O"/>
        <MenuItem Header="_Nova Cena…" Click="OnNewScene" InputGesture="Ctrl+N"/>
        <MenuItem Header="_Abrir Cena…" Click="OnOpenScene" InputGesture="Ctrl+O"/>
        <MenuItem Header="_Salvar" Click="OnSaveScene" InputGesture="Ctrl+S" IsEnabled="{Binding HasDocument}"/>
        <MenuItem Header="Salvar _Como…" Click="OnSaveSceneAs" InputGesture="Ctrl+Shift+S" IsEnabled="{Binding HasDocument}"/>
        <Separator/>
        <MenuItem Header="_Validar Projeto" Click="OnValidateProject" InputGesture="Ctrl+Shift+V"
                  IsEnabled="{Binding CanValidate}"
                  ToolTip.Tip="Procura referência quebrada em todas as cenas: textura/som/cena que não existe mais, componente que o jogo não conhece. Nada disso é erro de compilação."/>
        <Separator/>
        <MenuItem Header="_Build Jogo (Release)…" Click="OnBuildGame" IsEnabled="{Binding CanBuild}"/>
        <MenuItem Header="Exportar _Android (APK)…" Click="OnExportAndroid" IsEnabled="{Binding CanExportAndroid}"/>
        <Separator/>
        <MenuItem Header="Sai_r" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Editar">
        <MenuItem Header="_Desfazer" Click="OnUndo" InputGesture="Ctrl+Z" IsEnabled="{Binding CanUndo}"/>
        <MenuItem Header="_Refazer" Click="OnRedo" InputGesture="Ctrl+Y" IsEnabled="{Binding CanRedo}"/>
        <Separator/>
        <MenuItem Header="Du_plicar Entidade" Click="OnDuplicateEntity" InputGesture="Ctrl+D"
                  IsEnabled="{Binding HasSelectedEntity}"/>
        <MenuItem Header="_Copiar Entidade" Click="OnCopyEntity" InputGesture="Ctrl+C"
                  IsEnabled="{Binding HasSelectedEntity}"/>
        <MenuItem Header="Co_lar Entidade" Click="OnPasteEntity" InputGesture="Ctrl+V"
                  IsEnabled="{Binding CanPaste}"/>
        <Separator/>
        <MenuItem Header="_Configurações do Projeto…" Click="OnOpenProjectSettings"/>
        <Separator/>
        <MenuItem Header="Banco de _Dados (Itens)…" Click="OnOpenItemDatabase"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar de execução -->
    <Border DockPanel.Dock="Top" Background="#E7EEF7" Padding="8,5"
            BorderBrush="#D7DEE8" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="▶  Play (F5)" Click="OnPlay"
                IsEnabled="{Binding CanPlay}"
                FontSize="13" FontWeight="SemiBold" Padding="14,5"
                Background="#2E9E44" Foreground="White"/>
        <CheckBox Content="Colisores" IsChecked="{Binding ShowColliders}"
                  VerticalAlignment="Center" FontSize="12"
                  ToolTip.Tip="Mostra a hitbox de cada Collider no viewport: verde = sólido, laranja = trigger, tracejado = cinemático. Use 'Debug no jogo' pra ver isto rodando."/>
        <CheckBox Content="Debug no jogo" IsChecked="{Binding DebugOverlayOnPlay}"
                  VerticalAlignment="Center" FontSize="12"
                  ToolTip.Tip="Passa --debug pro jogo no Play: desenha as hitboxes por cima e escreve FPS/entidades/desenhos no canto."/>
        <CheckBox Content="Snap" IsChecked="{Binding SnapToGrid}"
                  VerticalAlignment="Center" FontSize="12"
                  ToolTip.Tip="Prende o arrasto a uma grade. Segure Alt durante o arrasto pra inverter."/>
        <NumericUpDown Value="{Binding SnapSize}" Minimum="1" Maximum="512" Increment="1"
                       FormatString="0" Width="88" FontSize="12" VerticalAlignment="Center"
                       IsEnabled="{Binding SnapToGrid}"
                       ToolTip.Tip="Tamanho da grade em pixels de mundo."/>
        <TextBlock Text="Projeto não configurado — preencha o campo PROJETO no inspector."
                   VerticalAlignment="Center" FontSize="11" Opacity="0.5"
                   IsVisible="{Binding !CanPlay}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#E7EEF7" Padding="8,4">
      <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8"
                 ToolTip.Tip="{Binding StatusDetail}"/>
    </Border>

    <!-- Painel de SAÍDA: stdout+stderr do jogo ao vivo. Ancorado embaixo (acima da status
         bar) e escondido até ter o que mostrar. Sem ele, um Console.WriteLine dentro de um
         script do usuário não tinha pra onde ir — o processo do jogo roda com CreateNoWindow
         e o resumo da status bar só aparece quando o jogo MORRE. -->
    <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Height="180"
            IsVisible="{Binding IsOutputVisible}"
            BorderBrush="#D7DEE8" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="SAÍDA" FontSize="11" FontWeight="Bold"
                       Foreground="#B9C4D0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Limpar" FontSize="11" Padding="8,2"
                    Click="OnClearOutput" Background="Transparent" Foreground="#B9C4D0"/>
            <Button Grid.Column="2" Content="✕" FontSize="11" Padding="8,2" Margin="4,0,0,0"
                    Click="OnCloseOutput" Background="Transparent" Foreground="#B9C4D0"
                    ToolTip.Tip="Fecha o painel. Ele reabre sozinho no próximo Play."/>
          </Grid>
        </Border>

        <ScrollViewer Name="OutputScroll" Padding="8,4">
          <ItemsControl ItemsSource="{Binding GameOutput}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                           FontSize="12" Foreground="#D6DEE8" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="264,4,*,4,330">

      <!-- Coluna do projeto: as cinco listas de arquivo em ABAS, e a hierarquia embaixo.
           Empilhadas, cada uma sobrava ~110px de altura numa coluna de 230 — cabiam três
           linhas por lista e o resto era rolagem. Em aba, a lista aberta usa a coluna toda, e
           a hierarquia (que se consulta o tempo todo enquanto se edita) fica sempre visível. -->
      <Grid Grid.Column="0" RowDefinitions="2*,4,3*">

        <TabControl Grid.Row="0" Padding="0" Margin="0">

          <TabItem FontSize="11" Header="Cenas">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,6">
                <Button Content="+" FontSize="12" Padding="8,2" Click="OnNewScene"
                        ToolTip.Tip="Nova cena"/>
                <Button Content="Excluir" FontSize="11" Padding="8,2" Click="OnDeleteScene"
                        IsEnabled="{Binding SelectedSceneFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Apaga o arquivo da cena selecionada"/>
                <Button Content="↻" FontSize="12" Padding="6,2" Click="OnRefreshScenes"
                        IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reescanear cenas do projeto"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding SceneFiles}" SelectedItem="{Binding SelectedSceneFile}"
                       DoubleTapped="OnSceneFileDoubleTapped"
                       ToolTip.Tip="Duplo-clique abre a cena">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem FontSize="11" Header="UI">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,6">
                <Button Content="+" FontSize="12" Padding="8,2" Click="OnNewUiScreen"
                        ToolTip.Tip="Nova tela de UI (HUD/menu)"/>
                <Button Content="Excluir" FontSize="11" Padding="8,2" Click="OnDeleteUiScreen"
                        IsEnabled="{Binding SelectedUiScreen, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Apaga o arquivo da tela selecionada"/>
                <Button Content="↻" FontSize="12" Padding="6,2" Click="OnRefreshUiScreens"
                        IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reescanear telas de UI"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding UiScreens}" SelectedItem="{Binding SelectedUiScreen}"
                       DoubleTapped="OnSceneFileDoubleTapped"
                       ToolTip.Tip="HUD/menu — componentes UiText/UiImage/UiBar/UiPanel em pixel de tela">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem FontSize="11" Header="Prefabs">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,6">
                <Button Content="Excluir" FontSize="11" Padding="8,2" Click="OnDeletePrefab"
                        IsEnabled="{Binding SelectedPrefab, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Apaga o arquivo do prefab selecionado"/>
                <Button Content="↻" FontSize="12" Padding="6,2" Click="OnRefreshPrefabs"
                        IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reescanear prefabs do projeto"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding Prefabs}" SelectedItem="{Binding SelectedPrefab}"
                       DoubleTapped="OnPrefabDoubleTapped"
                       ToolTip.Tip="Duplo-clique instancia na cena. Pra criar: botão direito numa entidade → salvar como prefab">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RelativePath}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem FontSize="11" Header="Scripts">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,6">
                <Button Content="+ Novo…" FontSize="11" Padding="8,2" Click="OnNewScript"
                        IsEnabled="{Binding HasDocument}"
                        ToolTip.Tip="Escolhe um template e abre o editor de código interno — salva em Scripts/ e registra o script na hora"/>
                <Button Content="Abrir…" FontSize="11" Padding="8,2" Click="OnLoadScript"
                        IsEnabled="{Binding HasDocument}"
                        ToolTip.Tip="Abre um .cs existente no editor de código interno"/>
                <Button Content="Excluir" FontSize="11" Padding="8,2" Click="OnDeleteScript"
                        IsEnabled="{Binding SelectedScript, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Apaga o arquivo .cs selecionado"/>
                <Button Content="↻" FontSize="12" Padding="6,2" Click="OnRefreshScriptFiles"
                        IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reescanear a pasta Scripts"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                       DoubleTapped="OnScriptFileDoubleTapped"
                       ToolTip.Tip="Duplo-clique abre no editor de código interno (Shift+duplo-clique abre no VS Code)">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RelativePath}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem FontSize="11" Header="Assets">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,6">
                <Button Content="+ Importar…" FontSize="11" Padding="8,2" Click="OnImportAssets"
                        IsEnabled="{Binding HasDocument}"
                        ToolTip.Tip="Copia imagem/áudio/fonte pra dentro do projeto (sprites/sounds/fonts)"/>
                <Button Content="Excluir" FontSize="11" Padding="8,2" Click="OnDeleteAsset"
                        IsEnabled="{Binding SelectedAsset, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Apaga o arquivo do asset selecionado"/>
                <Button Content="↻" FontSize="12" Padding="6,2" Click="OnRefreshAssets"
                        IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reescanear pasta de assets"/>
              </StackPanel>
              <ListBox x:Name="AssetList" ItemsSource="{Binding Assets}"
                       SelectedItem="{Binding SelectedAsset}"
                       DoubleTapped="OnAssetDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                      <Border Width="32" Height="32" Background="#E7EEF7" CornerRadius="3">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                               RenderOptions.BitmapInterpolationMode="None"/>
                      </Border>
                      <TextBlock Text="{Binding RelativePath}" VerticalAlignment="Center"
                                 FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

        </TabControl>

        <GridSplitter Grid.Row="1" Background="#D7DEE8"/>

        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Text="HIERARQUIA" Margin="10,8,10,4" FontSize="11"
                     FontWeight="Bold" Opacity="0.5"/>
          <TextBox DockPanel.Dock="Top" Margin="8,0,8,6" FontSize="12" Padding="6,3"
                   Watermark="Filtrar por nome…"
                   Text="{Binding EntityFilter}"
                   IsEnabled="{Binding HasDocument}"
                   ToolTip.Tip="Esconde da lista quem não bate com o texto. Não altera a cena."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8" Spacing="6">
            <Button Content="+ Nova" Click="OnCreateEntity" FontSize="12"
                    IsEnabled="{Binding HasDocument}"/>
            <Button Content="+ Tilemap" Click="OnCreateTilemap" FontSize="12"
                    IsEnabled="{Binding HasDocument}"/>
            <Button Content="Excluir" Click="OnDeleteEntity" FontSize="12"
                    IsEnabled="{Binding SelectedEntity, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>
          <Grid RowDefinitions="*,4,Auto">
            <ListBox Grid.Row="0" ItemsSource="{Binding Entities}"
                     SelectedItem="{Binding SelectedEntity}">
              <!-- Filtro por visibilidade do container, não por remover da coleção: assim a
                   entidade filtrada continua existindo, selecionada e indexada. -->
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="IsVisible" Value="{Binding MatchesFilter}"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                    <!-- Vínculo de pai marcado na própria linha: quem some de vista quando o pai
                         é arrastado é o filho, então dá pra saber quem vai junto sem abrir cada
                         entidade no inspector. -->
                    <TextBlock Grid.Column="1" Text="{Binding ParentLabel}" FontSize="10"
                               Opacity="0.55" Margin="6,0,0,0" VerticalAlignment="Center"
                               IsVisible="{Binding HasParent}"/>
                    <Border Grid.Column="2" Background="#4A90D9" CornerRadius="3" Padding="5,2"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            IsVisible="{Binding HasEventTrigger}">
                      <TextBlock Text="{Binding TriggerTypeLabel}" FontSize="10"
                                 Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Row="1" Background="#D7DEE8"
                          IsVisible="{Binding HasEventEntities}"/>

            <!-- Painel EVENTOS: lista rápida de entidades com EventTrigger -->
            <Border Grid.Row="2" Background="#EDF2FA"
                    IsVisible="{Binding HasEventEntities}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="EVENTOS" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" Margin="10,6,8,3"/>
                <ListBox ItemsSource="{Binding EventEntities}"
                         SelectedItem="{Binding SelectedEntity}"
                         Background="Transparent" MaxHeight="120">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#4A90D9" CornerRadius="3" Padding="4,1"
                                Margin="4,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TriggerTypeLabel}" FontSize="10"
                                     Foreground="#FFFFFF"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Background="#D7DEE8"/>

      <!-- Cena + paleta de tiles -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <views:SceneCanvas x:Name="Scene" Grid.Row="0" DataContext="{Binding}"/>
        <Border Grid.Row="1" Background="#E7EEF7" Padding="8,6"
                IsVisible="{Binding HasTilePalette}">
          <ListBox ItemsSource="{Binding PaletteTiles}"
                   SelectedItem="{Binding SelectedTileBrush}"
                   Background="Transparent" MaxHeight="96">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="36" Height="36" Background="#E7EEF7" CornerRadius="3"
                        ToolTip.Tip="{Binding Index}">
                  <Panel>
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="2"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <TextBlock Text="{Binding Label}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Panel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Background="#D7DEE8"/>

      <!-- Inspector -->
      <DockPanel Grid.Column="4">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,6,6,6">
          <TextBlock Text="INSPECTOR" VerticalAlignment="Center" FontSize="11"
                     FontWeight="Bold" Opacity="0.5"/>
          <Button Grid.Column="1" Content="⚙" FontSize="13" Padding="7,2"
                  Background="Transparent" BorderThickness="0"
                  Click="OnOpenProjectSettings"
                  ToolTip.Tip="Configurações do projeto (assets root, projeto do jogo, tela de referência, orientação Android)"/>
        </Grid>
        <ScrollViewer>
          <StackPanel Margin="10,0,10,10" DataContext="{Binding SelectedEntity}"
                      IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="90,*" Margin="0,0,0,8">
              <TextBlock Text="Nome" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
              <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="13" Padding="6,4"/>
            </Grid>

            <!-- Prefab: sem link vira botão pra criar; com link mostra nome + sync/apply -->
            <Button Content="Salvar como Prefab…" Click="OnSaveAsPrefab" FontSize="12"
                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    IsVisible="{Binding !HasPrefab}"/>
            <Border Background="#EDF2FA" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                    IsVisible="{Binding HasPrefab}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PrefabPath}" FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="↓ Atualizar da prefab" FontSize="11" Padding="6,3"
                          Command="{Binding SyncFromPrefabCommand}"
                          ToolTip.Tip="Substitui os componentes (menos Transform) pelos da prefab"/>
                  <Button Content="↑ Aplicar na prefab" FontSize="11" Padding="6,3"
                          Command="{Binding ApplyToPrefabCommand}"
                          ToolTip.Tip="Grava os componentes atuais (menos Transform) no arquivo da prefab"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Components}"/>

            <!-- Adicionar Componente -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#D7DEE8" Margin="0,8,0,4"/>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <ComboBox ItemsSource="{Binding AvailableComponentTypes}"
                        SelectedItem="{Binding NewComponentType}" FontSize="12"/>
              <Button Grid.Column="1" Content="+ Add" FontSize="12"
                      Padding="8,4" Margin="4,0,0,0"
                      Command="{Binding AddComponentCommand}"/>
              <Button Grid.Column="2" Content="↻" FontSize="12"
                      Padding="6,4" Margin="4,0,0,0"
                      Click="OnRefreshScripts"
                      ToolTip.Tip="Reroda o jogo e recarrega scripts [SceneScript] novos/editados"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
