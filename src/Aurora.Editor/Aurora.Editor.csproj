<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aurora.Editor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurora.Editor.Tests" />
  </ItemGroup>

  <!-- Quebra de linha do runtime reusada por link, não por referência de projeto: o editor é
       independente do Aurora.Runtime de propósito (mexe só no JSON da cena, sem GL), mas se o
       preview quebrasse linha diferente do jogo o editor voltaria a mentir. TextWrapper é
       estático e puro — recebe a largura de cada caractere por delegate — então compila sozinho. -->
  <ItemGroup>
    <Compile Include="..\Aurora.Runtime\Graphics\TextWrapper.cs" Link="Models\TextWrapper.cs" />
    <Compile Include="..\Aurora.Runtime\UI\UiAnchor.cs" Link="Models\UiAnchor.cs" />
    <!-- Lista das chaves de texto que a engine consulta, com o padrao de cada uma. Por link pelo
         mesmo motivo dos outros: duplicar a lista no editor faria a aba Termos oferecer chave que
         o runtime nao le (ou esquecer chave nova) sem nada avisar. So depende de System.Text.Json. -->
    <Compile Include="..\Aurora.Runtime\Database\TermDatabase.cs" Link="Models\TermDatabase.cs" />
    <!-- Formato do .sheet.json, pelo mesmo motivo: o editor de sprite sheet GRAVA o arquivo que
         o Animator LÊ. Duplicar a leitura aqui faria o editor salvar um campo que o jogo ignora
         (ou o contrário) sem nada acusar. Só depende de System.Text.Json; RectF vem junto porque
         é o tipo que SpriteSheetAsset devolve. -->
    <Compile Include="..\Aurora.Runtime\Graphics\RectF.cs" Link="Models\RectF.cs" />
    <Compile Include="..\Aurora.Runtime\Graphics\SpriteSheetAsset.cs" Link="Models\SpriteSheetAsset.cs" />
  </ItemGroup>

  <!-- Fonte padrão copiada pra saida do editor: o scaffolder de "Novo Projeto" a copia pro
       Assets/fonts do jogo gerado (ver GameProjectScaffolder.FindDefaultFont). Antes ela vinha
       de samples/, que foi removido do repo — projeto novo saía sem fonte e fechava sozinho
       no Play com FileNotFoundException. -->
  <ItemGroup>
    <Content Include="Assets\fonts\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
  </ItemGroup>

</Project>
