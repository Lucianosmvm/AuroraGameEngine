<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aurora.Editor\Aurora.Editor.csproj" />
    <!-- Explícito mesmo vindo de graça pelo editor: estes testes verificam que o JSON que o
         editor grava é o mesmo que o runtime lê, então a dependência é do teste, não um
         detalhe de quem ele referencia.

         Sem Aliases desde que o editor passou a referenciar o runtime de verdade: o alias
         existia só pra desambiguar as cópias de UiAnchor/TextWrapper que o editor compilava,
         e sem duplicata não há o que desambiguar. -->
    <ProjectReference Include="..\..\src\Aurora.Runtime\Aurora.Runtime.csproj" />
  </ItemGroup>

  <!-- Fonte de referência das medições. Copiada pra saída em vez de lida de um caminho
       relativo ao repositório: assim o teste não depende de onde a build coloca os binários. -->
  <ItemGroup>
    <Content Include="Assets\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
