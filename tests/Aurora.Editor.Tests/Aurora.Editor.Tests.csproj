<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aurora.Editor\Aurora.Editor.csproj" />
    <!-- O Aurora.Editor NÃO referencia o runtime de propósito (fica standalone, sem arrastar
         Silk.NET/OpenGL) — ele só linka dois arquivos de código. Aqui no teste os dois entram
         juntos porque é justamente o que precisa ser verificado: que o JSON que o editor grava
         é o mesmo que o runtime lê. Sem isso, um renomear de campo passaria despercebido. -->
    <!-- Alias porque o editor COMPILA cópias de UiAnchor/TextWrapper: sem separar os dois
         assemblies, todo uso desses tipos vira ambíguo nos testes que já existiam. -->
    <ProjectReference Include="..\..\src\Aurora.Runtime\Aurora.Runtime.csproj" Aliases="runtime" />
  </ItemGroup>

  <!-- Fonte de referência das medições. Copiada pra saída em vez de lida de um caminho
       relativo ao repositório: assim o teste não depende de onde a build coloca os binários. -->
  <ItemGroup>
    <Content Include="Assets\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
